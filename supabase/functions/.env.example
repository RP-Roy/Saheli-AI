# Supabase Edge Functions — Local Environment Secrets Template
# NEVER commit your actual GEMINI_API_KEY to Git.
#
# For Local Development (Supabase CLI):
# 1. Copy this file to `supabase/functions/.env`
# 2. Add your Google Gemini API key:
#    GEMINI_API_KEY=your_actual_gemini_api_key_here
# 3. Run: `supabase functions serve --env-file ./supabase/functions/.env`
#
# For Production (Supabase Dashboard):
# 1. Open Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# 2. Add secret: GEMINI_API_KEY = <your-api-key>
#    (Or via CLI: `supabase secrets set GEMINI_API_KEY=your_key`)

GEMINI_API_KEY=
